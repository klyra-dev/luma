{
  "manifest_version": 3,
  "name": "Luma — Brightness Controller",
  "short_name": "Luma",
  "version": "1.0.0",
  "description": "Privacy-first extension to adjust page brightness globally or per-site. No data collection or external network requests.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [],
  "minimum_chrome_version": "88"
}